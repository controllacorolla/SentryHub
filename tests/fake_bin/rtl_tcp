#!/usr/bin/env python3
# Test stand-in for rtl_tcp (RA-RADIO N1 regression): like osmocom rtl_tcp.c it printf()s
# "set freq N" to STDOUT on every retune, and writes the last applied frequency to $FAKE_STATE.
import socket, struct, sys, threading, time, os
a = sys.argv; port = int(a[a.index("-p")+1])
state = os.environ["FAKE_STATE"]
srv = socket.socket(); srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
srv.bind(("127.0.0.1", port)); srv.listen(1)
if os.environ.get("FAKE_GARBAGE"):             # bytes that are not UTF-8 (RA-RADIOc B6 pin)
    sys.stdout.buffer.write(b"\xff\xfe\xfd tuner\n" * 20); sys.stdout.buffer.flush()
print("listening..."); sys.stdout.flush()
c, _ = srv.accept()
c.sendall(b"RTL0" + struct.pack(">II", 5, 29))
def cmd():
    buf = b""
    while True:
        d = c.recv(4096)
        if not d: return
        buf += d
        while len(buf) >= 5:
            code, val = struct.unpack(">BI", buf[:5]); buf = buf[5:]
            if code == 1:
                print("set freq %d" % val); sys.stdout.flush()   # blocks once the pipe is full
                with open(state, "w") as f: f.write(str(val))
threading.Thread(target=cmd, daemon=True).start()
blk = bytes([127, 128]) * 20480
while True:
    try: c.sendall(blk)
    except OSError: break
    time.sleep(0.01)
