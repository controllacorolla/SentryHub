#!/usr/bin/env python3
# fake rtl_fm: loud int16 PCM forever (an always-active channel / a weather carrier)
import sys, time, struct, math
out = sys.stdout.buffer
buf = b"".join(struct.pack("<h", int(20000 * math.sin(i / 3.0))) for i in range(2048))
while True:
    try:
        out.write(buf)
        out.flush()
    except BrokenPipeError:
        sys.exit(0)
    time.sleep(0.02)
